[Unit]
Description=Panel interno de cuotas Carbonio
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=carbonio-quota
Group=carbonio-quota
WorkingDirectory=/opt/carbonio-quota-panel
EnvironmentFile=/etc/carbonio-quota-panel.env
ExecStart=/usr/bin/python3 -I /opt/carbonio-quota-panel/launch.py
Restart=on-failure
RestartSec=5
StateDirectory=carbonio-quota-panel
StateDirectoryMode=0700
UMask=0077
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
# On systemd 249, RestrictAddressFamilies implicitly sets NoNewPrivileges,
# which prevents the narrowly scoped sudo bridge from switching to zextras.
# Keep the dedicated user and filesystem protections; do not add seccomp-based
# restrictions that implicitly disable the required setuid transition.
NoNewPrivileges=false

[Install]
WantedBy=multi-user.target
